<?xml version="1.0"?>
<ruleset name="Group Password Reset">
	<description>WordPress coding standards for the Group Password Reset plugin.</description>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="extensions" value="php"/>

	<file>group-password-reset.php</file>
	<file>includes</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<!-- Vendored third-party library (Plugin Update Checker by Janis Elsts, MIT licensed); not our code to re-style. -->
	<exclude-pattern>*/plugin-update-checker/*</exclude-pattern>

	<config name="minimum_wp_version" value="6.9.4"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
